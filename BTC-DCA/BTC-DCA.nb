      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "sats", "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"Take", "[", 
            RowBox[{"dca", ",", 
             RowBox[{"-", "days"}]}], "]"}], ")"}]}], ")"}], "//", "Total"}], 
       ")"}], "*", 
      RowBox[{"currentprice", "/", "100000000"}]}], ")"}], "/", "days"}]}], 

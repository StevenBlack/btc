 RowBox[{
  RowBox[{"currentprice", "=", 
   RowBox[{"Last", "[", 
    RowBox[{"Last", "[", "nbtcusd", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dca", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"date", "->", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"price", "->", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"infl", "->", 
        RowBox[{"InflationAdjust", "[", 
         RowBox[{"Quantity", "[", 
          RowBox[{"1", ",", 
           RowBox[{"DatedUnit", "[", 
            RowBox[{"\"\<USDollars\>\"", ",", 
             RowBox[{"#", "[", 

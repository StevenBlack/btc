      RowBox[{"Today", "-", 
       RowBox[{"Quantity", "[", 
        RowBox[{"n", ",", "\"\<Days\>\""}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", 
        RowBox[{
         RowBox[{"Length", "[", "prices", "]"}], "-", "1"}]}], "}"}]}], "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"btcusd", " ", "=", 
    RowBox[{"TimeSeries", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"dates", ",", "prices"}], "}"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 

       RowBox[{"sats", "->", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{"100000000", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "purchcost"}], ")"}], "/", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}]}], "|>"}], "&"}], "/@",
     "nbtcusd"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cums", "=", 

       RowBox[{"sats", "->", 
        RowBox[{"IntegerPart", "[", 
         RowBox[{"100000000", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "purchcost"}], ")"}], "/", 
           RowBox[{"#", "[", 

    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "/", "#2"}], "&"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "[", "sats", "]"}], "&"}], " ", ",", " ", 
              RowBox[{"Reverse", "[", "dca", "]"}]}], "]"}], "//", 
            "Flatten"}], "//", "N"}], "//", "Accumulate"}]}], "]"}], "//", 
       "Flatten"}], ")"}], "*", 
     RowBox[{"currentprice", "/", "100000000"}]}], "//", "Reverse"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dca", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "\"\<dcaperf\>\""}], "]"}], "]"}], "=", "cums"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pv", "[", "days_", "]"}], ":=", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"btcdcaperformance", "=", 
   RowBox[{"DateListLogPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "date", "]"}], ",", 
         RowBox[{"#", "[", "\"\<dcaperf\>\"", "]"}]}], "}"}], "&"}], "/@", 
      "dca"}], "\[IndentingNewLine]", ",", 
     RowBox[{"AspectRatio", "\[Rule]", 
      RowBox[{"settings", "[", "aspectratio", "]"}]}], "\[IndentingNewLine]", 
     ",", 
     RowBox[{"Background", "->", 
      RowBox[{"settings", "[", "plotbackground", "]"}]}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"FrameTicks", "->", "All"}], "\[IndentingNewLine]", ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{"gridlinesx", ",", 
        RowBox[{"Join", "[", 
